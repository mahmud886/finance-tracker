    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const envBase = pm.environment.get('baseUrl');",
          "const colBase = pm.collectionVariables.get('baseUrl');",
          "let normalizedBase = envBase || colBase || 'http://localhost:3000/api/v1';",
          "if (/\/api\/?$/i.test(normalizedBase)) normalizedBase = normalizedBase.replace(/\/?$/,'/v1');",
          "if (!/\/api\/v1\/?$/i.test(normalizedBase)) normalizedBase = normalizedBase.replace(/\/?$/, '/api/v1');",
          "pm.environment.set('baseUrl', normalizedBase);",
          "pm.collectionVariables.set('baseUrl', normalizedBase);",
          "const cookie = pm.collectionVariables.get('authCookie') || pm.environment.get('authCookie');",
          "if (cookie && !pm.request.headers.has('Cookie')) {",
          "  pm.request.headers.add({ key: 'Cookie', value: cookie });",
          "}"
        ]
      }
    }
  ],
